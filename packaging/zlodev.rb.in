# Generated by zlodev's release workflow from packaging/zlodev.rb.in. Do not edit.
class Zlodev < Formula
  desc "Local HTTPS reverse proxy with custom DNS and a terminal UI"
  homepage "https://github.com/vandot/zlodev"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/vandot/zlodev/releases/download/v@VERSION@/zlodev-darwin-arm64.tar.gz"
      sha256 "@SHA_DARWIN_ARM64@"
    end
    on_intel do
      url "https://github.com/vandot/zlodev/releases/download/v@VERSION@/zlodev-darwin-amd64.tar.gz"
      sha256 "@SHA_DARWIN_AMD64@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/vandot/zlodev/releases/download/v@VERSION@/zlodev-linux-arm64.tar.gz"
      sha256 "@SHA_LINUX_ARM64@"
    end
    on_intel do
      url "https://github.com/vandot/zlodev/releases/download/v@VERSION@/zlodev-linux-amd64.tar.gz"
      sha256 "@SHA_LINUX_AMD64@"
    end
  end

  def install
    bin.install "zlodev"
  end

  def caveats
    s = "Run `zlodev install` once to set up the CA and DNS.\n"
    on_linux do
      s += <<~EOS
        To bind ports 53, 80 and 443 without root, run:
          sudo setcap cap_net_bind_service=+eip #{bin}/zlodev
        Repeat this after every upgrade.
      EOS
    end
    s
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/zlodev --version")
  end
end
